# syntax=docker/dockerfile:1
FROM ubuntu AS base

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV LANG=en_US.utf8
ENV LC_ALL=en_US.utf-8

RUN --mount=type=cache,id=ubuntu-x86_64-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=ubuntu-x86_64-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  sed -i 's@/archive.ubuntu.com/@/mirrors.aliyun.com/@g' /etc/apt/sources.list && \
  sed -i 's@/security.ubuntu.com/@/mirrors.aliyun.com/@g' /etc/apt/sources.list && \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  locales gcc g++ libncurses-dev vim net-tools curl iftop htop \
  build-essential gdb iproute2 libcurl4-openssl-dev gettext \
  autotools-dev autoconf automake unzip openssh-server git bsdextrautils \
  mold && \
  echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && locale-gen en_US.UTF-8

RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
  echo 'root:liuwenru' | chpasswd && \
  sed 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' -i /etc/pam.d/sshd && \
  echo "export VISIBLE=now" >> /etc/profile

RUN --mount=type=cache,id=ubuntu-x86_64-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=ubuntu-x86_64-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && \
  apt-get install -y --no-install-recommends x11vnc xvfb firefox gedit-dev xdotool

RUN mkdir /root/.vnc && \
  touch /root/.vnc/passwd && \
  x11vnc -storepasswd "p@ssw0rd" /root/.vnc/passwd

ENV DISPLAY=":1"

###############################    Devtools Env    ###############################

FROM base AS toolsdev
COPY devinstaller/toolsinstall.sh /opt/devinstaller/toolsinstall.sh
COPY devinstaller/bin/entrypoint.sh devinstaller/bin/tini-static-amd64 /opt/devinstaller/bin/
RUN --mount=type=cache,id=ubuntu-x86_64-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=ubuntu-x86_64-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  bash /opt/devinstaller/toolsinstall.sh
ENV PATH=/usr/local/git/bin:$PATH


FROM toolsdev AS cdev
COPY devinstaller/cinstall.sh /opt/devinstaller/cinstall.sh
RUN bash /opt/devinstaller/cinstall.sh
ENV PATH=/usr/local/cmake/bin:/usr/local/ctags/bin:$PATH

COPY devinstaller/luainstaller.sh /opt/devinstaller/luainstaller.sh
RUN --mount=type=cache,id=ubuntu-x86_64-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=ubuntu-x86_64-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  bash /opt/devinstaller/luainstaller.sh


FROM cdev AS golangdev
ENV GO111MODULE=on
ENV GOPROXY=https://goproxy.io,direct
ENV GOPATH=/opt/goworkspace
ENV PATH=/opt/go/bin:$GOPATH/bin:$PATH

COPY devinstaller/golanginstaller.sh /opt/devinstaller/golanginstaller.sh
RUN --mount=type=cache,id=ubuntu-x86_64-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=ubuntu-x86_64-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  bash /opt/devinstaller/golanginstaller.sh

RUN go install github.com/ramya-rao-a/go-outline@latest && \
  go install github.com/cweill/gotests/gotests@latest && \
  go install github.com/fatih/gomodifytags@latest && \
  go install github.com/josharian/impl@latest && \
  go install github.com/haya14busa/goplay/cmd/goplay@latest && \
  go install github.com/go-delve/delve/cmd/dlv@latest && \
  go install honnef.co/go/tools/cmd/staticcheck@latest && \
  go install golang.org/x/tools/gopls@latest && \
  go install github.com/jstemmer/gotags@latest && \
  go install mvdan.cc/sh/v3/cmd/gosh@latest && \
  go install mvdan.cc/sh/v3/cmd/shfmt@latest


FROM golangdev AS pydev
COPY devinstaller/pyinstaller.sh /opt/devinstaller/pyinstaller.sh
RUN rm -rf /opt/python* 2>/dev/null || true && \
  bash /opt/devinstaller/pyinstaller.sh


FROM pydev AS javadev
COPY devinstaller/javainstaller.sh /opt/devinstaller/javainstaller.sh
RUN bash /opt/devinstaller/javainstaller.sh

ENV JAVA_HOME=/usr/local/jdk
ENV ANT_HOME=/usr/local/ant
ENV MAVEN_HOME=/usr/local/maven
ENV PATH=$JAVA_HOME/bin:$ANT_HOME/bin:$MAVEN_HOME/bin:$PATH

FROM javadev AS nodedev
COPY devinstaller/nodejsinstaller.sh /opt/devinstaller/nodejsinstaller.sh
RUN bash /opt/devinstaller/nodejsinstaller.sh


# RUN bash /opt/devinstaller/download-vs-code.sh "linux" "x64" --use-commit f6cfa2ea2403534de03f069bdf160d06451ed282

# RUN for ext in $(cat /opt/devinstaller/vscode-plugin-list.txt); do \
#   ~/.vscode-server/bin/*/bin/code-server --accept-server-license-terms --force --install-extension $ext; \
#   done

FROM nodedev AS final
COPY devinstaller /opt/devinstaller
RUN rm -rf /tmp/*
RUN chsh -s /usr/bin/bash

COPY ubuntu_dev/start.sh /start.sh
RUN chmod +x /start.sh /tini

ENTRYPOINT ["/tini", "-g", "--","/entrypoint.sh"]
CMD ["/bin/bash", "/start.sh"]
