# syntax=docker/dockerfile:1
FROM fedora AS base

RUN curl -o /etc/yum.repos.d/fedora.repo http://mirrors.aliyun.com/repo/fedora.repo && \
    curl -o /etc/yum.repos.d/fedora-updates.repo http://mirrors.aliyun.com/repo/fedora-updates.repo && \
    dnf install langpacks-en glibc-all-langpacks -y && \
    dnf clean all

RUN --mount=type=cache,target=/var/cache/dnf \
    dnf -y install openssh openssh-server openssh-clients ccache mold && \
    dnf clean all

RUN --mount=type=cache,target=/var/cache/dnf \
    dnf -y install \
        vim gcc gcc-c++ perl-Encode* perl-Data-Dumper perl-Text-Unidecode perl-libintl \
        autoconf automake libtool file bison* texinfo ncurses-* make gperf rsync \
  gettext-devel wget patch CUnit-devel net-tools iproute gdb binutils libcurl-devel git openssl-devel && \
    dnf clean all

ENV LANG=en_US.utf-8
ENV LC_ALL=en_US.utf-8

# ccache + mold 全局生效
ENV CC="ccache gcc" \
    CXX="ccache g++" \
    CCACHE_DIR=/root/.ccache \
    CCACHE_SLOPPINESS="time_macros,include_file_mtime,file_macro,locale,clang_index_store" \
    CCACHE_BASEDIR=/tmp
ENV PATH=/usr/libexec/ccache:$PATH

###############################    Devtools Env    ###############################

COPY devinstaller /opt/devinstaller

RUN bash /opt/devinstaller/toolsinstall.sh
ENV PATH=/usr/local/git/bin:$PATH


RUN bash /opt/devinstaller/cinstall.sh
ENV PATH=/usr/local/cmake/bin:/usr/local/ctags/bin:$PATH

RUN bash /opt/devinstaller/luainstaller.sh


ENV GO111MODULE=on
ENV GOPROXY=https://goproxy.io,direct
ENV GOPATH=/opt/goworkspace
ENV PATH=/opt/go/bin:$GOPATH/bin:$PATH

RUN bash /opt/devinstaller/golanginstaller.sh

RUN go install github.com/ramya-rao-a/go-outline@latest && \
    go install github.com/cweill/gotests/gotests@latest && \
    go install github.com/fatih/gomodifytags@latest && \
    go install github.com/josharian/impl@latest && \
    go install github.com/haya14busa/goplay/cmd/goplay@latest && \
    go install github.com/go-delve/delve/cmd/dlv@latest && \
    go install honnef.co/go/tools/cmd/staticcheck@latest && \
    go install golang.org/x/tools/gopls@latest && \
    go install github.com/jstemmer/gotags@latest && \
    go install mvdan.cc/sh/v3/cmd/gosh@latest && \
    go install mvdan.cc/sh/v3/cmd/shfmt@latest


RUN bash /opt/devinstaller/nodejsinstaller.sh


RUN --mount=type=cache,target=/root/.ccache,sharing=locked \
  rm -rf /opt/python* 2>/dev/null || true && \
  ccache -M 20G && \
  bash /opt/devinstaller/pyinstaller.sh


RUN bash /opt/devinstaller/javainstaller.sh

ENV JAVA_HOME=/usr/local/jdk
ENV ANT_HOME=/usr/local/ant
ENV MAVEN_HOME=/usr/local/maven
ENV PATH=$JAVA_HOME/bin:$ANT_HOME/bin:$MAVEN_HOME/bin:$PATH


# RUN bash /opt/devinstaller/download-vs-code.sh "linux" "x64" --use-commit f6cfa2ea2403534de03f069bdf160d06451ed282

# RUN for ext in $(cat /opt/devinstaller/vscode-plugin-list.txt); do \
#       ~/.vscode-server/bin/*/bin/code-server --accept-server-license-terms --force --install-extension $ext; \
#     done

RUN rm -rf /tmp/* /var/cache/dnf/*
RUN chsh -s /usr/bin/bash

COPY start.sh /start.sh
RUN chmod +x /start.sh /tini

ENTRYPOINT ["/tini", "-g", "--","/entrypoint.sh"]
CMD ["/bin/bash", "/start.sh"]
